    "dotenv": "^16.4.7",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
