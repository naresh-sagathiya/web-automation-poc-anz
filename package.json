{
  "name": "web-automation-poc-anz",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright and Cucumber BDD automation starter",
  "scripts": {
    "test": "cucumber-js",
    "test:headed": "powershell -Command \"$env:HEADLESS='false'; cucumber-js; Remove-Item Env:HEADLESS\"",
    "test:mfa": "powershell -Command \"$env:HEADLESS='false'; cucumber-js src/features/mfa.feature; Remove-Item Env:HEADLESS\"",
    "test:bill": "powershell -Command \"$env:HEADLESS='false'; cucumber-js src/features/billpay.feature; Remove-Item Env:HEADLESS\"",
    "test:debug": "powershell -Command \"$env:PWDEBUG='1'; cucumber-js; Remove-Item Env:PWDEBUG\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "dotenv": "^16.4.7",
    "otplib": "^13.5.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "cross-env": "^7.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
